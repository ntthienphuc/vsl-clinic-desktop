# Keep provenance/checksum inputs byte-identical across Windows and Linux clones.
# Text files still receive normal text diffs; only line-ending conversion is off.
* -text
# CRLF bytes are intentional in the pinned inputs, not trailing spaces.
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Show the app's own languages in GitHub statistics; retain bundled notices.
licenses/** linguist-vendored=true
backend/legacy/** linguist-vendored=true
docs/evidence/** linguist-generated=true
public/fonts/** linguist-vendored=true
assets/multimodal100/server/vendor/** linguist-vendored=true
assets/multimodal100/r3/vendor/** linguist-vendored=true
installer/Vietnamese.isl linguist-vendored=true
# Pinned upstream bytes must retain their original whitespace for hash parity.
assets/multimodal100/server/vendor/** -whitespace
assets/multimodal100/r3/vendor/** -whitespace
assets/multimodal100/r3/deps/** linguist-vendored=true -whitespace
